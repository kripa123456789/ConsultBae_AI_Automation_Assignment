    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    p.person_id,\n    p.canonical_name,\n    COALESCE(\n        STRING_AGG(DISTINCT cs.skill_name, ', ' ORDER BY cs.skill_name),\n        ''\n    ) AS skills\nFROM persons p\nLEFT JOIN ai_skill_classifications a\n    ON a.person_id = p.person_id\nLEFT JOIN candidate_skills cs\n    ON cs.person_id = p.person_id\nWHERE a.person_id IS NULL\nGROUP BY p.person_id, p.canonical_name\nORDER BY p.person_id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -208,
        -80
      ],
      "id": "da55b6bf-034f-4db3-bdfe-eacd084b37e2",
      "name": "Execute a SQL query",
